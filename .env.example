# Copy this file to .env and fill in real values before running the app

# Secret used to sign session/JWT tokens - change this to a long random string
JWT_SECRET=change_this_to_a_long_random_string

# Secret used to sign license keys - keep this ONLY on the developer/admin machine
LICENSE_SECRET=change_this_to_a_different_long_random_string

# Port the server runs on
PORT=3000

# The master password to log into YOUR (development company) admin portal
# Only one super-admin account is seeded using these values
ADMIN_EMAIL='test@gmail.com'  
ADMIN_PASSWORD='123456'

# Set to "true" once you've scanned the WhatsApp QR code and want auto-connect on boot
WHATSAPP_ENABLED=true
